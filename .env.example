# ---------------------------------------------------------------------------
# OCR for scanned PDFs (RAPID OCR — free, offline)
#   auto (default) use OCR when the PDF has no text layer and RapidOCR is installed
#   on   require OCR; fail if RapidOCR is unavailable
#   off  reject image-only PDFs
# ---------------------------------------------------------------------------
RESUMEIQ_OCR=auto
RESUMEIQ_OCR_DPI=200

# --- ResumeIQ configuration ---

# Chat template debug output when things go wrong
# RESUMEIQ_DEBUG=1

# Identical JD inputs are served from a local cache (sha256 of JD text,
# temperature 0 + fixed seed). Set to 0 to bypass.
# Stores ONLY JD-derived fields — never resume text or PII.
RESUMEIQ_LLM_CACHE=1

# LLM mode: auto | ollama | cloud | offline
#   auto    (default) Ollama if reachable, else cloud if key set, else deterministic
#   ollama  require local Ollama; fail loudly if unavailable
#   cloud   require a free OpenAI-compatible endpoint (see DEPLOYMENT.md); fail loudly if unset
#   offline never call an LLM; deterministic extraction only (zero third parties)
RESUMEIQ_LLM=auto

# Local model served by Ollama
OLLAMA_BASE_URL=http://localhost:11434
RESUMEIQ_OLLAMA_MODEL=qwen2.5:3b

# Cloud (OpenAI-compatible) — free tiers:
#   Groq:            https://api.groq.com/openai/v1            llama-3.3-70b-versatile
#   Google Gemini:   https://generativelanguage.googleapis.com/v1beta/openai/   gemini-2.0-flash
#   GitHub Models:   https://models.inference.ai.azure.com     Llama-3.3-70B-Instruct
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile

# Scoring rubric weights (hypothesis — calibrate with evaluation/evaluate.py)
RESUMEIQ_W_REQUIRED=40
RESUMEIQ_W_EXPERIENCE=25
RESUMEIQ_W_RESPONSIBILITIES=20
RESUMEIQ_W_PREFERRED=10
RESUMEIQ_W_QUALIFICATIONS=5
