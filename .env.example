# --- ResumeIQ configuration ---

# LLM mode: auto | ollama | offline
#   auto    (default) use local Ollama if reachable, else deterministic extraction
#   ollama  require Ollama; fail loudly if unavailable
#   offline never call an LLM; deterministic extraction only (fastest, fully reproducible)
RESUMEIQ_LLM=auto

# Local model served by Ollama
OLLAMA_BASE_URL=http://localhost:11434
RESUMEIQ_OLLAMA_MODEL=qwen2.5:3b

# Scoring rubric weights (hypothesis — calibrate with evaluation/evaluate.py)
RESUMEIQ_W_REQUIRED=40
RESUMEIQ_W_EXPERIENCE=25
RESUMEIQ_W_RESPONSIBILITIES=20
RESUMEIQ_W_PREFERRED=10
RESUMEIQ_W_QUALIFICATIONS=5
